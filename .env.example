# Claude (or run `ant auth login` instead)
ANTHROPIC_API_KEY=

# Sleeper - public API, no auth needed
SLEEPER_USERNAME=
SLEEPER_LEAGUE_ID=

# ESPN - espn_s2 and SWID cookies are only needed for private leagues
ESPN_LEAGUE_ID=
ESPN_TEAM_ID=
ESPN_S2=
ESPN_SWID=

# Optional overrides
# FF_SEASON=2026
# FF_DEFAULT_PLATFORM=sleeper
# FF_CACHE_DIR=~/.cache/ffagent
# FF_MODEL=claude-opus-5-5
